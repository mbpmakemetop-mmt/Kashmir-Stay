rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ══════════════════════════════════════════════════════════
    // HELPERS
    // ══════════════════════════════════════════════════════════
    function signedIn() { return request.auth != null; }

    // Admin = your Google account, and Google must have verified the email
    function isAdmin() {
      return signedIn()
        && request.auth.token.email == 'abrarrtallks@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function isOwner() { return signedIn() && request.auth.uid == resource.data.user_id; }

    function isOwnerOfBusiness(bizId) {
      return signedIn()
        && get(/databases/$(database)/documents/businesses/$(bizId)).data.user_id == request.auth.uid;
    }

    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    function shortText(v, max) { return v is string && v.size() <= max; }

    // ══════════════════════════════════════════════════════════
    // USERS — nobody can make themselves premium/admin
    // ══════════════════════════════════════════════════════════
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();

      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('uid', uid) == uid
        && !request.resource.data.keys().hasAny(['is_premium','premium_plan','premium_expiry','payment_id','role','is_admin']);

      allow update: if isAdmin() || (signedIn() && request.auth.uid == uid
        && !changed().hasAny(['uid','is_premium','premium_plan','premium_expiry','payment_id','role','is_admin']));

      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // BUSINESSES
    //  • New listings always start as 'pending' (admin approves)
    //  • Owners can edit their details, but NOT premium / spotlight /
    //    storage / approval / rating / ownership — only the server can
    // ══════════════════════════════════════════════════════════
    match /businesses/{bizId} {

      function lockedForOwner() {
        return ['is_premium','premium_plan','premium_expiry','payment_id','razorpay_order_id',
                'spotlight_until','spotlight_plan','spotlight_active','spotlight_started','spotlight_expired_at',
                'image_limit','storage_plan','storage_payment_id','package_slots',
                'user_id','user_email','rating','review_count',
                'approved_at','created_at','biz_id','is_govt_verified'];
      }

      function ownerEdit() {
        return isOwner()
          && !changed().hasAny(lockedForOwner())
          // owners may only send their listing back to review, never approve it
          && (!changed().hasAny(['status']) || request.resource.data.status == 'pending');
      }

      // Any signed-in user may update ONLY rating + review_count, and the
      // count can move by at most 1 (one review added / removed / edited)
      function ratingUpdate() {
        let oldCount = resource.data.get('review_count', 0);
        let newCount = request.resource.data.review_count;
        return signedIn()
          && changed().hasOnly(['rating', 'review_count'])
          && newCount is int && newCount >= 0
          && newCount <= oldCount + 1 && newCount >= oldCount - 1
          && request.resource.data.rating is number
          && request.resource.data.rating >= 0
          && request.resource.data.rating <= 5;
      }

      allow read: if resource.data.status == 'approved' || isOwner() || isAdmin();

      allow create: if isAdmin() || (signedIn()
        && request.resource.data.user_id == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('review_count', 0) == 0
        && !request.resource.data.keys().hasAny(['spotlight_until','spotlight_active','spotlight_plan',
                                                  'spotlight_started','image_limit','storage_plan','approved_at',
                                                  'package_slots']));

      allow update: if isAdmin() || ownerEdit() || ratingUpdate();

      allow delete: if isOwner() || isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // TOUR PACKAGES
    //  • Doc id = <businessId>_<slot>. Slot must be within the
    //    business's package_slots (3 free; +1 per ₹49 paid — set by server)
    //  • Only the owner of an APPROVED business can add packages
    //  • Live instantly; owner can hide; admin can hide/delete anything
    // ══════════════════════════════════════════════════════════
    match /packages/{pkgId} {
      function bizData(id) { return get(/databases/$(database)/documents/businesses/$(id)).data; }

      // Tour package (travel agencies) — no "kind" field, as before
      function validTourPackage(d) {
        return d.keys().hasOnly(['biz_id','biz_name','user_id','slot','type','title','description',
                                 'image_url','image_path','nights','days','price','price_unit',
                                 'places','includes','itinerary','status','created_at','updated_at','page_url'])
          && d.type in ['honeymoon','couple','family','group','snow','adventure','budget','luxury','pilgrimage','custom']
          && d.nights is int && d.nights >= 0 && d.nights <= 30
          && d.days is int && d.days >= 0 && d.days <= 31
          && d.price_unit in ['per person','per couple','per group']
          && d.places is list && d.places.size() <= 20
          && d.includes is list && d.includes.size() <= 20
          && d.itinerary is list && d.itinerary.size() <= 15;
      }

      // Room (hotels, houseboats, resorts, guest houses…) — kind == 'room', same slots
      function validRoom(d) {
        return d.keys().hasOnly(['kind','biz_id','biz_name','user_id','slot','type','title','description',
                                 'image_url','image_path','price','price_unit','guests','beds','meals','amenities',
                                 'status','created_at','updated_at'])
          && d.kind == 'room'
          && d.type in ['standard','deluxe','superdeluxe','suite','family','hbroom','cottage','dorm']
          && d.price_unit in ['per night','per person per night']
          && d.guests is int && d.guests >= 1 && d.guests <= 20
          && d.beds in ['Double bed','King bed','Twin beds','Single bed','Bunk beds']
          && d.meals in ['Room only','Breakfast included','Breakfast & dinner','All meals']
          && d.amenities is list && d.amenities.size() <= 20;
      }

      function validPackage() {
        let d = request.resource.data;
        return (d.get('kind', 'package') == 'room' ? validRoom(d) : validTourPackage(d))
          && d.title is string && d.title.size() >= 5 && d.title.size() <= 80
          && d.description is string && d.description.size() >= 20 && d.description.size() <= 400
          && d.image_url is string && d.image_url.matches('https://firebasestorage[.]googleapis[.]com/.*')
          && d.image_path is string && d.image_path.matches('packages/' + d.biz_id + '/.*')
          && (d.price == null || (d.price is int && d.price >= 0 && d.price <= 10000000))
          && d.status in ['live','hidden']
          && shortText(d.biz_name, 120);
      }

      allow read: if resource.data.status == 'live'
                  || (signedIn() && resource.data.user_id == request.auth.uid)
                  || isAdmin();

      allow create: if isAdmin() || (signedIn()
        && validPackage()
        && request.resource.data.user_id == request.auth.uid
        && bizData(request.resource.data.biz_id).user_id == request.auth.uid
        && bizData(request.resource.data.biz_id).status == 'approved'
        && request.resource.data.slot is int
        && request.resource.data.slot >= 1
        && request.resource.data.slot <= bizData(request.resource.data.biz_id).get('package_slots', 3)
        && pkgId == request.resource.data.biz_id + '_' + string(request.resource.data.slot)
        && !('page_url' in request.resource.data));

      allow update: if isAdmin() || (signedIn()
        && resource.data.user_id == request.auth.uid
        && bizData(resource.data.biz_id).user_id == request.auth.uid
        && validPackage()
        && !changed().hasAny(['biz_id','user_id','slot','created_at','page_url','kind']));

      allow delete: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════
    // ANALYTICS (legacy) — owners read, only server/admin writes
    // ══════════════════════════════════════════════════════════
    match /analytics/{businessId} {
      allow read: if isAdmin() || isOwnerOfBusiness(businessId);
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // ANALYTICS EVENTS — anyone can log a view/click, but only
    // in the exact shape the site sends (no junk, no huge docs)
    // ══════════════════════════════════════════════════════════
    match /analytics_events/{eventId} {
      allow read: if isAdmin() || (signedIn() && isOwnerOfBusiness(resource.data.biz_id));

      allow create: if request.resource.data.keys().hasOnly(['biz_id','type','created_at','ts'])
        && shortText(request.resource.data.biz_id, 100)
        && request.resource.data.type in ['view','phone','whatsapp','website']
        && request.resource.data.created_at == request.time;

      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // NOTIFICATIONS — only admin/server can send them
    // ══════════════════════════════════════════════════════════
    match /notifications/{notificationId} {
      allow read, update: if signedIn() && resource.data.user_id == request.auth.uid;
      allow create: if isAdmin();
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // PAYMENTS — users can only file records for themselves.
    // (These are receipts only; premium is granted by the server.)
    // ══════════════════════════════════════════════════════════
    match /payments/{payId} {
      allow read: if (signedIn() && request.auth.uid == resource.data.user_id) || isAdmin();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // REVIEWS
    // ══════════════════════════════════════════════════════════
    match /reviews/{reviewId} {
      function validReview() {
        return request.resource.data.rating is number
          && request.resource.data.rating >= 1
          && request.resource.data.rating <= 5
          && shortText(request.resource.data.get('comment', ''), 500)
          && shortText(request.resource.data.get('user_name', ''), 100);
      }

      allow read: if true;

      allow create: if isAdmin() || (signedIn()
        && request.resource.data.user_id == request.auth.uid
        && shortText(request.resource.data.business_id, 100)
        && validReview());

      allow update: if isAdmin() || (signedIn()
        && resource.data.user_id == request.auth.uid
        && changed().hasOnly(['rating', 'comment', 'updated_at'])
        && validReview());

      allow delete: if isAdmin() || (signedIn() && resource.data.user_id == request.auth.uid);
    }

    // ══════════════════════════════════════════════════════════
    // OWNERSHIP CLAIMS
    // ══════════════════════════════════════════════════════════
    match /ownership_claims/{claimId} {
      allow read: if signedIn() && (
        request.auth.uid == resource.data.requester_uid ||
        request.auth.uid == resource.data.current_owner_uid ||
        isAdmin()
      );
      allow create: if signedIn()
        && request.resource.data.requester_uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && shortText(request.resource.data.get('requester_message', ''), 1000);
      allow update: if isAdmin() || (signedIn() && request.auth.uid == resource.data.current_owner_uid
        && changed().hasOnly(['status', 'resolved_at']));
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // SUPPORT CHAT — users can only write in THEIR OWN conversation
    // ══════════════════════════════════════════════════════════
    match /chat_conversations/{convId} {
      allow read: if (signedIn() && request.auth.uid == resource.data.user_id) || isAdmin();
      allow create: if signedIn() && request.resource.data.user_id == request.auth.uid;
      allow update: if isAdmin() || (signedIn() && request.auth.uid == resource.data.user_id
        && !changed().hasAny(['user_id']));
      allow delete: if isAdmin();

      match /messages/{msgId} {
        function convOwner() {
          return get(/databases/$(database)/documents/chat_conversations/$(convId)).data.user_id;
        }
        allow read: if isAdmin() || (signedIn() && request.auth.uid == convOwner());
        allow create: if isAdmin() || (signedIn()
          && request.auth.uid == convOwner()
          && request.resource.data.sender == 'user'
          && shortText(request.resource.data.text, 2000));
        allow delete: if isAdmin();
      }
    }

    // ══════════════════════════════════════════════════════════
    // CONTACT FORM (public) — size-limited
    // ══════════════════════════════════════════════════════════
    match /contact_messages/{msgId} {
      allow read, update, delete: if isAdmin();
      allow create: if request.resource.data.keys().size() <= 15
        && shortText(request.resource.data.get('message', ''), 3000);
    }

    // ══════════════════════════════════════════════════════════
    // BUG REPORTS
    // ══════════════════════════════════════════════════════════
    match /bug_reports/{reportId} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == resource.data.reported_by_uid);
      allow create: if signedIn() && request.resource.data.reported_by_uid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // PUBLIC CONTENT (admin writes)
    // ══════════════════════════════════════════════════════════
    match /updates/{updateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // FREE SPOTLIGHT HOUR (owner watched 2 ads in the app)
    // Owner of an APPROVED business, at most once every 20 hours.
    // Doc id = business id. last_at must be the server time, so the
    // limit can't be faked with the phone's clock. Paid spotlights
    // (spotlight_until on the business) are never touched by this.
    // ══════════════════════════════════════════════════════════
    match /spot_boosts/{bizId} {
      function validFreeSpot() {
        let biz = get(/databases/$(database)/documents/businesses/$(bizId)).data;
        return signedIn()
          && biz.user_id == request.auth.uid
          && biz.status == 'approved'
          && request.resource.data.keys().hasOnly(['biz_id', 'user_id', 'last_at'])
          && request.resource.data.biz_id == bizId
          && request.resource.data.user_id == request.auth.uid
          && request.resource.data.last_at == request.time;
      }
      allow read: if true;
      allow create: if validFreeSpot();
      allow update: if validFreeSpot()
        && resource.data.last_at < request.time - duration.value(20, 'h');
      allow delete: if isAdmin();
    }

    // ══════════════════════════════════════════════════════════
    // DEFAULT DENY
    // ══════════════════════════════════════════════════════════
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
